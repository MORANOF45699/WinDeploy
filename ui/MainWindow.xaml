<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDeploy"
        Height="880" Width="1240" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <Window.Resources>

    <!-- ==================== palette ==================== -->
    <SolidColorBrush x:Key="Bg"         Color="#12141A"/>
    <SolidColorBrush x:Key="Surface"    Color="#1A1D26"/>
    <SolidColorBrush x:Key="Surface2"   Color="#222634"/>
    <SolidColorBrush x:Key="Surface3"   Color="#2A2F3F"/>
    <SolidColorBrush x:Key="Line"       Color="#2E3444"/>
    <SolidColorBrush x:Key="LineSoft"   Color="#252A37"/>
    <SolidColorBrush x:Key="Text"       Color="#E7EAF2"/>
    <SolidColorBrush x:Key="TextDim"    Color="#98A1B8"/>
    <SolidColorBrush x:Key="TextFaint"  Color="#6C7488"/>
    <SolidColorBrush x:Key="Accent"     Color="#5B8DEF"/>
    <SolidColorBrush x:Key="AccentHot"  Color="#7BA5F7"/>
    <SolidColorBrush x:Key="AccentDim"  Color="#2B4270"/>
    <SolidColorBrush x:Key="Danger"     Color="#F2646A"/>
    <SolidColorBrush x:Key="DangerDim"  Color="#4A2027"/>
    <SolidColorBrush x:Key="Warn"       Color="#F5B942"/>
    <SolidColorBrush x:Key="WarnDim"    Color="#40331A"/>
    <SolidColorBrush x:Key="Ok"         Color="#57D9A3"/>
    <SolidColorBrush x:Key="OkDim"      Color="#1D3A31"/>

    <!-- ==================== scrollbars ==================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="b" Background="#3A4157" CornerRadius="4" Margin="3"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#4E576F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="11"/>
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ==================== text ==================== -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style x:Key="Header" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Margin" Value="0,18,0,7"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="LineHeight" Value="17"/>
    </Style>

    <!-- ==================== buttons ==================== -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="90"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface3}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#3E4759"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#191D28"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.38"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#0B1220"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHot}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#4577CC"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource Danger}"/>
      <Setter Property="BorderBrush" Value="#5A2A30"/>
    </Style>

    <!-- ==================== inputs ==================== -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#3B4356"/>
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- DisplayMemberPath does not survive a replaced ComboBox template, so the
         combos that show objects get this template explicitly instead -->
    <DataTemplate x:Key="DisplayItem">
      <TextBlock Text="{Binding Display}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentDim}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextDim}" StrokeThickness="1.4"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="BorderBrush" Value="#3B4356"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="6" Margin="0,4,0,0"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.55" Color="#000000"/>
                  </Border.Effect>
                  <ScrollViewer Margin="4">
                    <StackPanel IsItemsHost="True"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ==================== check / radio ==================== -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="17" Height="17" CornerRadius="4"
                      Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                      BorderThickness="1.2" VerticalAlignment="Center">
                <Path x:Name="tick" Data="M 2.5 6 L 6 9.5 L 12 2.5" Stroke="#0B1220" StrokeThickness="2"
                      Visibility="Collapsed" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentHot}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- DataGridCheckBoxColumn builds its own CheckBox, so it needs the style
         handed to it explicitly or it falls back to the light default -->
    <Style x:Key="GridCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="17" Height="17" VerticalAlignment="Center">
                <Ellipse x:Name="ring" Stroke="{StaticResource Line}" StrokeThickness="1.4"
                         Fill="{StaticResource Surface2}"/>
                <Ellipse x:Name="dot" Width="7" Height="7" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}"/>
                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource AccentHot}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ==================== progress ==================== -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Background" Value="{StaticResource Surface3}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
              <Grid>
                <Rectangle x:Name="PART_Track"/>
                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" RadiusX="3" RadiusY="3">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#4C7FE0" Offset="0"/>
                      <GradientStop Color="#6FA8FF" Offset="1"/>
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ==================== tabs (left rail) ==================== -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid>
              <Border x:Name="b" Background="Transparent" CornerRadius="7" Margin="8,3,8,3"
                      Padding="14,11">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="2,9,0,9"
                      CornerRadius="2" Background="Transparent"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1E2330"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2}"/>
                <Setter TargetName="bar" Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{StaticResource Surface}"
                      BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="20,20,20,14">
                    <TextBlock Text="WinDeploy" Style="{StaticResource H1}"/>
                    <TextBlock Text="ISO installer / USB / drivers" FontSize="11"
                               Foreground="{StaticResource TextDim}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <!-- StackPanel, not TabPanel: TabPanel lays tabs out in wrapping
                       rows, which turns a vertical rail into a jumbled grid -->
                  <StackPanel IsItemsHost="True" Orientation="Vertical"
                              DockPanel.Dock="Top" Margin="0,4,0,0"/>
                </DockPanel>
              </Border>
              <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ==================== cards ==================== -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="NoteOk" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource OkDim}"/>
      <Setter Property="BorderBrush" Value="#2E5C4C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="13,11"/>
    </Style>

    <Style x:Key="NoteWarn" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource WarnDim}"/>
      <Setter Property="BorderBrush" Value="#6B5420"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="13,11"/>
    </Style>

    <Style x:Key="NoteDanger" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource DangerDim}"/>
      <Setter Property="BorderBrush" Value="#6E3038"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="13,11"/>
    </Style>

    <!-- ==================== data grid ==================== -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1E2431"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentDim}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RowHeight" Value="32"/>
      <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
      <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGrid">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="7" ClipToBounds="True" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                <ScrollViewer.Template>
                  <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <DataGridColumnHeadersPresenter Grid.Row="0" Grid.Column="0"
                          Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                      <ScrollContentPresenter Grid.Row="1" Grid.Column="0" x:Name="PART_ScrollContentPresenter"/>
                      <ScrollBar Grid.Row="1" Grid.Column="1" x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                                 Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                 Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                 Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                      <ScrollBar Grid.Row="2" Grid.Column="0" x:Name="PART_HorizontalScrollBar" Orientation="Horizontal"
                                 Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                 Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                 Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                  </ControlTemplate>
                </ScrollViewer.Template>
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- log rows -->
    <Style x:Key="LogList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <!-- ============================== layout ============================== -->
  <DockPanel>

    <!-- status strip -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock x:Name="TxtStatus" Text="Ready." TextTrimming="CharacterEllipsis"
                     FontSize="12.5" Foreground="{StaticResource TextDim}"/>
          <ProgressBar x:Name="Progress" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="BtnToggleLog" Content="Hide log" Width="96"/>
        <Button Grid.Column="2" x:Name="BtnCancel" Content="Cancel" IsEnabled="False" Width="96" Margin="0"
                Style="{StaticResource DangerBtn}"/>
      </Grid>
    </Border>

    <!-- log pane -->
    <Border x:Name="LogPane" DockPanel.Dock="Bottom" Height="180" Background="#0D0F14"
            BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="16,10">
      <ListBox x:Name="LstLog" Style="{StaticResource LogList}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                       FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Padding="0,1"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <TabControl x:Name="Tabs">

      <!-- ============ INSTALL ============ -->
      <TabItem Header="Install to partition">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,20,22">
          <StackPanel MaxWidth="1120">

            <TextBlock Text="Install to a partition" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                       Text="Applies the image next to your current Windows and adds a second boot menu entry. The machine you are on now keeps working."/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="1  WINDOWS SOURCE" Margin="0,0,0,7"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" x:Name="TxtIso" Margin="0,0,8,0"/>
                  <Button Grid.Column="1" x:Name="BtnBrowseIso" Content="Browse ISO" Width="112"/>
                  <Button Grid.Column="2" x:Name="BtnLoadIso"   Content="Read editions" Width="120" Margin="0"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="An .iso file, or a folder you already extracted one into."/>

                <TextBlock Style="{StaticResource Header}" Text="2  EDITION"/>
                <ComboBox x:Name="CmbEdition" ItemTemplate="{StaticResource DisplayItem}"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="3  TARGET DISK" Margin="0,0,0,7"/>
                <DataGrid x:Name="GridDisks" Height="132">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#"        Binding="{Binding DiskNumber}"     Width="36"/>
                    <DataGridTextColumn Header="DISK"     Binding="{Binding FriendlyName}"   Width="*"/>
                    <DataGridTextColumn Header="BUS"      Binding="{Binding BusType}"        Width="64"/>
                    <DataGridTextColumn Header="STYLE"    Binding="{Binding PartitionStyle}" Width="64"/>
                    <DataGridTextColumn Header="SIZE"     Binding="{Binding SizeGB}"         Width="86"/>
                    <DataGridTextColumn Header="FREE GAP" Binding="{Binding FreeGB}"         Width="86"/>
                    <DataGridTextColumn Header="VOLUMES"  Binding="{Binding Volumes}"        Width="120"/>
                    <DataGridTextColumn Header="NOTE"     Binding="{Binding Safety}"         Width="150"/>
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="BtnRefreshDisks" Content="Refresh disks" Width="128"/>
                  <TextBlock x:Name="TxtFirmware" Foreground="{StaticResource Accent}" Margin="6,0,0,0" FontSize="12"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="4  WHERE THE NEW WINDOWS GOES" Margin="0,0,0,9"/>
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="RadNewPart" Content="Create a new partition" IsChecked="True"
                               GroupName="Target" Margin="0,0,26,0"/>
                  <RadioButton x:Name="RadExistingPart" Content="Use an existing partition (erases it)" GroupName="Target"/>
                </StackPanel>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Size (GB)" Foreground="{StaticResource TextDim}" Margin="0,0,10,0"/>
                  <TextBox   Grid.Column="1" x:Name="TxtSizeGB" Text="120"/>
                  <TextBlock Grid.Column="2" Text="Shrink this if needed" Foreground="{StaticResource TextDim}" Margin="22,0,10,0"/>
                  <ComboBox  Grid.Column="3" x:Name="CmbShrink" ItemTemplate="{StaticResource DisplayItem}"/>
                </Grid>

                <DataGrid x:Name="GridPartitions" Height="128" Margin="0,14,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="PART"   Binding="{Binding PartitionNumber}" Width="52"/>
                    <DataGridTextColumn Header="LETTER" Binding="{Binding DriveLetter}"     Width="66"/>
                    <DataGridTextColumn Header="LABEL"  Binding="{Binding Label}"           Width="160"/>
                    <DataGridTextColumn Header="FS"     Binding="{Binding FileSystem}"      Width="66"/>
                    <DataGridTextColumn Header="SIZE"   Binding="{Binding SizeGB}"          Width="96"/>
                    <DataGridTextColumn Header="FREE"   Binding="{Binding FreeGB}"          Width="96"/>
                    <DataGridTextColumn Header="TYPE"   Binding="{Binding Type}"            Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="5  OPTIONS" Margin="0,0,0,9"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Boot menu name" Foreground="{StaticResource TextDim}" Margin="0,0,10,0"/>
                  <TextBox   Grid.Column="1" x:Name="TxtEntryName" Text="Windows (new)"/>
                </Grid>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" x:Name="ChkInjectDrivers" Content="Inject a driver backup" Margin="0,0,14,0"/>
                  <TextBox  Grid.Column="1" x:Name="TxtInjectPath" IsEnabled="False" Margin="0,0,8,0"/>
                  <Button   Grid.Column="2" x:Name="BtnBrowseInject" Content="Browse" IsEnabled="False" Width="96" Margin="0"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Injected offline, before first boot, so the new Windows comes up with network and display drivers already working."/>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox  Grid.Column="0" x:Name="ChkUnattend" Content="Skip most of OOBE" Margin="0,0,22,0"/>
                  <TextBlock Grid.Column="1" Text="PC name" Foreground="{StaticResource TextDim}" Margin="0,0,10,0"/>
                  <TextBox   Grid.Column="2" x:Name="TxtComputerName" IsEnabled="False"/>
                  <TextBlock Grid.Column="3" Text="User" Foreground="{StaticResource TextDim}" Margin="18,0,10,0"/>
                  <TextBox   Grid.Column="4" x:Name="TxtUserName" IsEnabled="False"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource NoteOk}">
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ok}"
                         Text="The boot menu is written last. If anything fails before that, this PC still boots exactly as it does now."/>
            </Border>

            <Button x:Name="BtnInstall" Content="Install Windows" Style="{StaticResource Primary}"
                    Margin="0,18,0,0" HorizontalAlignment="Left" Width="210"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ SETUP FROM DISK ============ -->
      <TabItem Header="Install without USB">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,20,22">
          <StackPanel MaxWidth="1120">

            <TextBlock Text="Install without a USB stick" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                       Text="Copies the ISO to a folder on a disk you already have, then adds a ramdisk boot entry for sources\boot.wim. The next boot lands in the real Windows Setup wizard running off the hard disk - so it can wipe C: and do a genuine clean install, with no USB stick involved."/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="1  WINDOWS SOURCE" Margin="0,0,0,7"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" x:Name="TxtSetupIso" Margin="0,0,8,0"/>
                  <Button Grid.Column="1" x:Name="BtnBrowseSetupIso" Content="Browse ISO" Width="112"/>
                  <Button Grid.Column="2" x:Name="BtnCopyIsoPath2"   Content="Same as tab 1" Width="120" Margin="0"/>
                </Grid>

                <TextBlock Style="{StaticResource Header}" Text="2  WHERE TO KEEP THE SETUP FILES"/>
                <ComboBox x:Name="CmbSetupHost" ItemTemplate="{StaticResource DisplayItem}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="BtnRefreshSetupHost" Content="Refresh volumes" Width="140"/>
                  <TextBlock x:Name="TxtSetupNeed" Foreground="{StaticResource Accent}" Margin="6,0,0,0" FontSize="12"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource NoteDanger}" Margin="0,0,0,14">
              <TextBlock TextWrapping="Wrap" Foreground="#FF9AA0"
                         Text="Setup reads install.wim off this volume while it installs, so do NOT delete this partition inside Setup. Keep the files on a data partition and wipe C: only. Putting them on C: itself means Setup cannot wipe C: at all."/>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="3  BOOT ENTRY" Margin="0,0,0,7"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Name" Foreground="{StaticResource TextDim}" Margin="0,0,10,0"/>
                  <TextBox   Grid.Column="1" x:Name="TxtSetupEntryName" Text="Windows Setup (WinDeploy)"/>
                </Grid>
                <CheckBox x:Name="ChkOneShot" IsChecked="True" Margin="0,14,0,0"
                          Content="One-time boot - go to Setup on the next restart only, then back to the normal menu"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="The boot store is backed up automatically before any change. The Boot menu tab can restore it."/>
              </StackPanel>
            </Border>

            <Button x:Name="BtnMakeSetupEntry" Content="Prepare Setup boot entry" Style="{StaticResource Primary}"
                    HorizontalAlignment="Left" Width="250"/>

            <TextBlock Style="{StaticResource Header}" Text="4  AFTERWARDS - CLEAN UP"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                       Text="Once the new Windows is installed and working, remove the entry and the copied files to get the space back. Pick the entry on the Boot menu tab first."/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnRemoveSetupEntry" Content="Remove setup entry + files" Width="216"/>
              <Button x:Name="BtnRebootToSetup" Content="Reboot into Setup now" Width="192"
                      Style="{StaticResource DangerBtn}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ USB ============ -->
      <TabItem Header="Create bootable USB">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,20,22">
          <StackPanel MaxWidth="1120">

            <TextBlock Text="Create a bootable USB" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                       Text="GPT + FAT32, which is what UEFI firmware with Secure Boot will actually boot."/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="1  WINDOWS SOURCE" Margin="0,0,0,7"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" x:Name="TxtUsbIso" Margin="0,0,8,0"/>
                  <Button Grid.Column="1" x:Name="BtnBrowseUsbIso" Content="Browse ISO" Width="112"/>
                  <Button Grid.Column="2" x:Name="BtnCopyIsoPath"  Content="Same as tab 1" Width="120" Margin="0"/>
                </Grid>

                <TextBlock Style="{StaticResource Header}" Text="2  USB STICK - EVERYTHING ON IT IS ERASED"/>
                <DataGrid x:Name="GridUsb" Height="150">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#"       Binding="{Binding DiskNumber}"   Width="36"/>
                    <DataGridTextColumn Header="DEVICE"  Binding="{Binding FriendlyName}" Width="*"/>
                    <DataGridTextColumn Header="SIZE"    Binding="{Binding SizeGB}"       Width="96"/>
                    <DataGridTextColumn Header="VOLUMES" Binding="{Binding Volumes}"      Width="170"/>
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="BtnRefreshUsb" Content="Refresh" Width="112"/>
                  <TextBlock Text="Volume label" Foreground="{StaticResource TextDim}" Margin="14,0,10,0"/>
                  <TextBox x:Name="TxtUsbLabel" Text="WINSETUP" Width="150"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource NoteWarn}">
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}"
                         Text="An install.wim over 4 GB is split into .swm files automatically. On a stick larger than 32 GB the remainder becomes a plain NTFS data partition. Only removable USB disks are listed."/>
            </Border>

            <Button x:Name="BtnMakeUsb" Content="Create bootable USB" Style="{StaticResource Primary}"
                    Margin="0,18,0,0" HorizontalAlignment="Left" Width="230"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ DRIVERS ============ -->
      <TabItem Header="Drivers">
        <Grid Margin="26,22,20,22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Drivers" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Back up every third-party driver on this machine, then put them back on a fresh install. Microsoft's own inbox drivers are filtered out - the new Windows brings its own."/>
          </StackPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnScanDrivers" Content="Scan drivers" Width="128"/>
            <Button x:Name="BtnSelectAll"   Content="Select all"   Width="98"/>
            <Button x:Name="BtnSelectNone"  Content="Select none"  Width="106"/>
            <CheckBox x:Name="ChkIncludeInbox" Content="Include inbox drivers" Margin="10,0,0,0"/>
            <TextBlock Text="Filter" Foreground="{StaticResource TextDim}" Margin="20,0,10,0"/>
            <TextBox x:Name="TxtFilter" Width="170"/>
            <TextBlock x:Name="TxtDriverCount" Foreground="{StaticResource Accent}" Margin="14,0,0,0"
                       FontSize="12" TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <DataGrid Grid.Row="2" x:Name="GridDrivers" IsReadOnly="False" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Width="38"
                                      ElementStyle="{StaticResource GridCheck}"
                                      EditingElementStyle="{StaticResource GridCheck}"
                                      Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              <DataGridTextColumn Header="PROVIDER" Binding="{Binding Provider}"     Width="170" IsReadOnly="True"/>
              <DataGridTextColumn Header="CLASS"    Binding="{Binding ClassName}"    Width="120" IsReadOnly="True"/>
              <DataGridTextColumn Header="DEVICE"   Binding="{Binding Devices}"      Width="*"   IsReadOnly="True"/>
              <DataGridTextColumn Header="VERSION"  Binding="{Binding Version}"      Width="130" IsReadOnly="True"/>
              <DataGridTextColumn Header="DATE"     Binding="{Binding DriverDate}"   Width="96"  IsReadOnly="True"/>
              <DataGridTextColumn Header="INF"      Binding="{Binding OemInf}"       Width="86"  IsReadOnly="True"/>
              <DataGridTextColumn Header="ORIGINAL" Binding="{Binding OriginalName}" Width="150" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>

          <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="BACK UP" Margin="0,0,0,7"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" x:Name="TxtBackupDest" Margin="0,0,8,0"/>
                  <Button  Grid.Column="1" x:Name="BtnBrowseBackupDest" Content="Browse" Width="92" Margin="0"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" x:Name="ChkZip" Content="Zip it" VerticalAlignment="Center"/>
                  <Button   Grid.Column="1" x:Name="BtnBackupDrivers" Content="Back up selected"
                            HorizontalAlignment="Right" Width="168" Margin="0"
                            Style="{StaticResource Primary}" FontSize="12.5" Padding="14,8"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="RESTORE" Margin="0,0,0,7"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" x:Name="TxtRestoreSrc" Margin="0,0,8,0"/>
                  <Button  Grid.Column="1" x:Name="BtnBrowseRestoreFolder" Content="Folder" Width="88"/>
                  <Button  Grid.Column="2" x:Name="BtnBrowseRestoreZip"    Content="Zip"    Width="76" Margin="0"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <RadioButton x:Name="RadRestoreOnline" Content="Into this running Windows"
                                 IsChecked="True" GroupName="Restore"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <RadioButton x:Name="RadRestoreOffline" Content="Into another Windows on"
                                   GroupName="Restore" Margin="0,0,10,0"/>
                      <ComboBox x:Name="CmbOfflineDrive" Width="88" IsEnabled="False"/>
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="BtnRestoreDrivers" Content="Restore" Width="120"
                          Margin="12,0,0,0" VerticalAlignment="Bottom"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ============ RECLAIM SPACE ============ -->
      <TabItem Header="Reclaim space">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,20,22">
          <StackPanel MaxWidth="1120">

            <TextBlock Text="Reclaim space after a reinstall" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                       Text="Windows can only grow a partition into free space that sits directly after it. A Recovery partition parked in the middle is what greys out Extend Volume in Disk Management. This moves WinRE out of the way properly, deletes the stale recovery partition, extends, then builds a fresh recovery partition at the end of the disk and re-registers WinRE."/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="1  DISK LAYOUT" Margin="0,0,0,7"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Disk" Foreground="{StaticResource TextDim}" Margin="0,0,10,0"/>
                  <ComboBox  Grid.Column="1" x:Name="CmbReclaimDisk" ItemTemplate="{StaticResource DisplayItem}"/>
                  <Button    Grid.Column="2" x:Name="BtnRefreshReclaim" Content="Refresh" Width="106" Margin="10,0,0,0"/>
                  <TextBlock Grid.Column="3" x:Name="TxtWinReState" Foreground="{StaticResource Accent}"
                             Margin="14,0,0,0" FontSize="12"/>
                </Grid>

                <DataGrid x:Name="GridLayout" Height="190" Margin="0,12,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="KIND"   Binding="{Binding Kind}"   Width="110"/>
                    <DataGridTextColumn Header="PART"   Binding="{Binding Number}" Width="60"/>
                    <DataGridTextColumn Header="SIZE"   Width="110"
                                        Binding="{Binding SizeGB, StringFormat={}{0:N2} GB}"/>
                    <DataGridTextColumn Header="DETAIL" Binding="{Binding Note}"   Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Listed in the order they physically sit on the disk, unallocated gaps included."/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="2  PARTITION TO GROW" Margin="0,0,0,7"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0" x:Name="CmbReclaimTarget" ItemTemplate="{StaticResource DisplayItem}"/>
                  <Button   Grid.Column="1" x:Name="BtnAnalyzeReclaim" Content="Analyze" Width="120" Margin="10,0,0,0"/>
                </Grid>
                <CheckBox x:Name="ChkRecreateRecovery" IsChecked="True" Margin="0,14,0,0"
                          Content="Rebuild the recovery partition afterwards and re-enable WinRE (recommended)"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Unticked, WinRE stays disabled - Reset this PC and startup repair will not work until you turn it back on."/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="3  PLAN" Margin="0,0,0,7"/>
                <Border Background="#0D0F14" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="6" Padding="14,12" MinHeight="150">
                  <TextBox x:Name="TxtReclaimPlan" Background="Transparent" BorderThickness="0"
                           Foreground="{StaticResource Text}" FontFamily="Cascadia Mono, Consolas"
                           FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           Text="Pick a disk and a partition, then press Analyze. Nothing is touched until you press Reclaim."/>
                </Border>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource NoteWarn}" Margin="0,0,0,14">
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}"
                         Text="Only recovery partitions are ever deleted. If anything else stands in the way - the EFI partition, or a partition with your data on it - the plan stops there and says so instead of removing it."/>
            </Border>

            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnReclaimDryRun" Content="Dry run" Width="130"/>
              <Button x:Name="BtnReclaimGo" Content="Reclaim space" Style="{StaticResource Primary}" Width="190"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ BOOT MENU ============ -->
      <TabItem Header="Boot menu">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,20,22">
          <StackPanel MaxWidth="1120">

            <TextBlock Text="Boot menu" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                       Text="Read through the BCD WMI provider, so entry names come out right on a non-English Windows too."/>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DataGrid x:Name="GridBoot" Height="250">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="ID"   Binding="{Binding Id}"          Width="310"/>
                    <DataGridCheckBoxColumn Header="RUNNING NOW" Binding="{Binding IsCurrent}" Width="110"
                                            ElementStyle="{StaticResource GridCheck}"/>
                  </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button x:Name="BtnRefreshBoot"  Content="Refresh" Width="106"/>
                  <Button x:Name="BtnRenameEntry"  Content="Rename" Width="106"/>
                  <Button x:Name="BtnDefaultEntry" Content="Make default" Width="130"/>
                  <Button x:Name="BtnDeleteEntry"  Content="Delete" Width="106" Style="{StaticResource DangerBtn}"/>
                  <TextBlock Text="Timeout (s)" Foreground="{StaticResource TextDim}" Margin="20,0,10,0"/>
                  <TextBox x:Name="TxtTimeout" Text="15" Width="66"/>
                  <Button x:Name="BtnSetTimeout" Content="Apply" Width="88" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Hint}"
                           Text="Deleting an entry only removes it from the boot menu. The files on that partition stay where they are - remove them with Disk Management afterwards if you want the space back."/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="BOOT STORE BACKUPS" Margin="0,0,0,7"/>
                <StackPanel Orientation="Horizontal">
                  <ComboBox x:Name="CmbBcdBackups" Width="380" ItemTemplate="{StaticResource DisplayItem}"/>
                  <Button x:Name="BtnBackupBcd"  Content="Back up now" Width="132" Margin="10,0,8,0"/>
                  <Button x:Name="BtnRestoreBcd" Content="Restore selected" Width="152"
                          Style="{StaticResource DangerBtn}" Margin="0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="A backup is taken automatically before anything writes to the boot store. Restore puts the whole store back the way it was - use it if the boot menu ends up wrong."/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <TextBlock Style="{StaticResource Header}" Text="SHORTCUTS" Margin="0,0,0,9"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="BtnReboot" Content="Reboot now" Width="136" Style="{StaticResource DangerBtn}"/>
                  <Button x:Name="BtnOpenLogFolder" Content="Open log folder" Width="150"/>
                  <Button x:Name="BtnOpenDiskMgmt" Content="Disk Management" Width="164" Margin="0"/>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
