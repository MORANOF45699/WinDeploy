<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDeploy - ISO installer, USB writer, driver backup"
        Height="820" Width="1180" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="#F3F3F3">

  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="MinWidth" Value="90"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="4,3"/>
    </Style>
    <Style x:Key="Header" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
      <Setter Property="Foreground" Value="#1B4B72"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#666"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="Background" Value="White"/>
    </Style>
  </Window.Resources>

  <DockPanel>

    <!-- status strip -->
    <Border DockPanel.Dock="Bottom" Background="#E8E8E8" BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock x:Name="TxtStatus" Text="Ready." TextTrimming="CharacterEllipsis"/>
          <ProgressBar x:Name="Progress" Height="14" Margin="0,4,10,0" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="BtnToggleLog" Content="Hide log" Width="90"/>
        <Button Grid.Column="2" x:Name="BtnCancel" Content="Cancel" IsEnabled="False" Width="90" Margin="0"/>
      </Grid>
    </Border>

    <!-- log pane -->
    <Border x:Name="LogPane" DockPanel.Dock="Bottom" Height="170" Background="#1E1E1E" Padding="6">
      <TextBox x:Name="TxtLog" Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0"
               FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </Border>

    <TabControl x:Name="Tabs" Margin="8">

      <!-- ============ INSTALL ============ -->
      <TabItem Header="  Install to partition  ">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14,8,14,14">

            <TextBlock Style="{StaticResource Header}" Text="1. Windows source"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" x:Name="TxtIso" Margin="0,0,6,0"/>
              <Button Grid.Column="1" x:Name="BtnBrowseIso" Content="Browse ISO..."  Width="110"/>
              <Button Grid.Column="2" x:Name="BtnLoadIso"   Content="Read editions" Width="110" Margin="0"/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="An .iso file, or a folder you already extracted one into."/>

            <TextBlock Style="{StaticResource Header}" Text="2. Edition"/>
            <ComboBox x:Name="CmbEdition" DisplayMemberPath="Display"/>

            <TextBlock Style="{StaticResource Header}" Text="3. Target disk"/>
            <DataGrid x:Name="GridDisks" Height="130">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#"        Binding="{Binding DiskNumber}"     Width="34"/>
                <DataGridTextColumn Header="Disk"     Binding="{Binding FriendlyName}"   Width="*"/>
                <DataGridTextColumn Header="Bus"      Binding="{Binding BusType}"        Width="60"/>
                <DataGridTextColumn Header="Style"    Binding="{Binding PartitionStyle}" Width="60"/>
                <DataGridTextColumn Header="Size"     Binding="{Binding SizeGB}"         Width="80"/>
                <DataGridTextColumn Header="Free gap" Binding="{Binding FreeGB}"         Width="80"/>
                <DataGridTextColumn Header="Volumes"  Binding="{Binding Volumes}"        Width="130"/>
                <DataGridTextColumn Header="Note"     Binding="{Binding Safety}"         Width="140"/>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button x:Name="BtnRefreshDisks" Content="Refresh disks" Width="120"/>
              <TextBlock x:Name="TxtFirmware" VerticalAlignment="Center" Foreground="#1B4B72" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock Style="{StaticResource Header}" Text="4. Where the new Windows goes"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="RadNewPart" Content="Create a new partition" IsChecked="True" GroupName="Target" Margin="0,0,20,0"/>
              <RadioButton x:Name="RadExistingPart" Content="Use an existing partition (erases it)" GroupName="Target"/>
            </StackPanel>

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Size (GB):" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox   Grid.Column="1" x:Name="TxtSizeGB" Text="120"/>
              <TextBlock Grid.Column="2" Text="Shrink this partition if needed:" VerticalAlignment="Center" Margin="16,0,6,0"/>
              <ComboBox  Grid.Column="3" x:Name="CmbShrink" DisplayMemberPath="Display"/>
            </Grid>

            <DataGrid x:Name="GridPartitions" Height="120" Margin="0,8,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Part" Binding="{Binding PartitionNumber}" Width="44"/>
                <DataGridTextColumn Header="Letter" Binding="{Binding DriveLetter}"   Width="56"/>
                <DataGridTextColumn Header="Label"  Binding="{Binding Label}"         Width="150"/>
                <DataGridTextColumn Header="FS"     Binding="{Binding FileSystem}"    Width="60"/>
                <DataGridTextColumn Header="Size"   Binding="{Binding SizeGB}"        Width="90"/>
                <DataGridTextColumn Header="Free"   Binding="{Binding FreeGB}"        Width="90"/>
                <DataGridTextColumn Header="Type"   Binding="{Binding Type}"          Width="*"/>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource Header}" Text="5. Options"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Boot menu name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox   Grid.Column="1" x:Name="TxtEntryName" Text="Windows (new)"/>
            </Grid>

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <CheckBox Grid.Column="0" x:Name="ChkInjectDrivers" Content="Inject a driver backup" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox  Grid.Column="1" x:Name="TxtInjectPath" IsEnabled="False" Margin="0,0,6,0"/>
              <Button   Grid.Column="2" x:Name="BtnBrowseInject" Content="Browse..." IsEnabled="False" Width="90" Margin="0"/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Injected offline, before first boot, so the new Windows comes up with network and display drivers already working."/>

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <CheckBox  Grid.Column="0" x:Name="ChkUnattend" Content="Skip most of OOBE" VerticalAlignment="Center" Margin="0,0,14,0"/>
              <TextBlock Grid.Column="1" Text="PC name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox   Grid.Column="2" x:Name="TxtComputerName" IsEnabled="False"/>
              <TextBlock Grid.Column="3" Text="User:" VerticalAlignment="Center" Margin="14,0,6,0"/>
              <TextBox   Grid.Column="4" x:Name="TxtUserName" IsEnabled="False"/>
            </Grid>

            <Border Background="#FFF4CE" BorderBrush="#E6C200" BorderThickness="1" Padding="10" Margin="0,14,0,0" CornerRadius="3">
              <TextBlock TextWrapping="Wrap" Text="The boot menu is written last. If anything fails before that, this PC still boots exactly as it does now."/>
            </Border>

            <Button x:Name="BtnInstall" Content="Install Windows" Height="38" FontWeight="SemiBold"
                    Margin="0,14,0,0" HorizontalAlignment="Left" Width="200" Background="#0F6CBD" Foreground="White"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ USB ============ -->
      <TabItem Header="  Create bootable USB  ">
        <StackPanel Margin="14,8,14,14">
          <TextBlock Style="{StaticResource Header}" Text="1. Windows source"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TxtUsbIso" Margin="0,0,6,0"/>
            <Button Grid.Column="1" x:Name="BtnBrowseUsbIso" Content="Browse ISO..." Width="110"/>
            <Button Grid.Column="2" x:Name="BtnCopyIsoPath"  Content="Same as tab 1" Width="110" Margin="0"/>
          </Grid>

          <TextBlock Style="{StaticResource Header}" Text="2. USB stick (everything on it will be erased)"/>
          <DataGrid x:Name="GridUsb" Height="150">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#"       Binding="{Binding DiskNumber}"   Width="34"/>
              <DataGridTextColumn Header="Device"  Binding="{Binding FriendlyName}" Width="*"/>
              <DataGridTextColumn Header="Size"    Binding="{Binding SizeGB}"       Width="90"/>
              <DataGridTextColumn Header="Volumes" Binding="{Binding Volumes}"      Width="160"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="BtnRefreshUsb" Content="Refresh" Width="110"/>
            <TextBlock Text="Volume label:" VerticalAlignment="Center" Margin="14,0,6,0"/>
            <TextBox x:Name="TxtUsbLabel" Text="WINSETUP" Width="140"/>
          </StackPanel>

          <Border Background="#FDE7E9" BorderBrush="#D13438" BorderThickness="1" Padding="10" Margin="0,14,0,0" CornerRadius="3">
            <TextBlock TextWrapping="Wrap"
                       Text="GPT + FAT32, which is what UEFI firmware with Secure Boot will actually boot. An install.wim over 4 GB is split into .swm files automatically. On a stick larger than 32 GB the remainder becomes a plain NTFS data partition."/>
          </Border>

          <Button x:Name="BtnMakeUsb" Content="Create bootable USB" Height="38" FontWeight="SemiBold"
                  Margin="0,14,0,0" HorizontalAlignment="Left" Width="220" Background="#0F6CBD" Foreground="White"/>
        </StackPanel>
      </TabItem>

      <!-- ============ DRIVERS ============ -->
      <TabItem Header="  Drivers  ">
        <Grid Margin="14,8,14,14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnScanDrivers" Content="Scan drivers" Width="120"/>
            <Button x:Name="BtnSelectAll"   Content="Select all"   Width="90"/>
            <Button x:Name="BtnSelectNone"  Content="Select none"  Width="90"/>
            <CheckBox x:Name="ChkIncludeInbox" Content="Include Microsoft inbox drivers" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <TextBox x:Name="TxtFilter" Width="180"/>
            <TextBlock x:Name="TxtDriverCount" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#1B4B72"/>
          </StackPanel>

          <DataGrid Grid.Row="1" x:Name="GridDrivers" IsReadOnly="False" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
              <DataGridTextColumn Header="Provider" Binding="{Binding Provider}"     Width="160" IsReadOnly="True"/>
              <DataGridTextColumn Header="Class"    Binding="{Binding ClassName}"    Width="110" IsReadOnly="True"/>
              <DataGridTextColumn Header="Device"   Binding="{Binding Devices}"      Width="*"   IsReadOnly="True"/>
              <DataGridTextColumn Header="Version"  Binding="{Binding Version}"      Width="120" IsReadOnly="True"/>
              <DataGridTextColumn Header="Date"     Binding="{Binding DriverDate}"   Width="90"  IsReadOnly="True"/>
              <DataGridTextColumn Header="INF"      Binding="{Binding OemInf}"       Width="80"  IsReadOnly="True"/>
              <DataGridTextColumn Header="Original" Binding="{Binding OriginalName}" Width="140" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource Header}" Text="Backup"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox  Grid.Column="0" x:Name="TxtBackupDest" Margin="0,0,6,0"/>
              <Button   Grid.Column="1" x:Name="BtnBrowseBackupDest" Content="Browse..." Width="90"/>
              <CheckBox Grid.Column="2" x:Name="ChkZip" Content="Zip it" VerticalAlignment="Center" Margin="4,0,10,0"/>
              <Button   Grid.Column="3" x:Name="BtnBackupDrivers" Content="Back up selected" Width="150" Margin="0"
                        Background="#0F6CBD" Foreground="White"/>
            </Grid>

            <TextBlock Style="{StaticResource Header}" Text="Restore"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" x:Name="TxtRestoreSrc" Margin="0,0,6,0"/>
              <Button  Grid.Column="1" x:Name="BtnBrowseRestoreFolder" Content="Folder..." Width="90"/>
              <Button  Grid.Column="2" x:Name="BtnBrowseRestoreZip"    Content="Zip..."    Width="90" Margin="0"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <RadioButton x:Name="RadRestoreOnline" Content="Into this running Windows" IsChecked="True" GroupName="Restore" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <RadioButton x:Name="RadRestoreOffline" Content="Into another Windows on drive:" GroupName="Restore" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox x:Name="CmbOfflineDrive" Width="80" IsEnabled="False"/>
              <Button x:Name="BtnRestoreDrivers" Content="Restore" Width="120" Margin="16,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============ BOOT MENU ============ -->
      <TabItem Header="  Boot menu  ">
        <StackPanel Margin="14,8,14,14">
          <TextBlock Style="{StaticResource Header}" Text="Windows boot entries"/>
          <DataGrid x:Name="GridBoot" Height="260">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Description}" Width="*"/>
              <DataGridTextColumn Header="Id"   Binding="{Binding Id}"          Width="300"/>
              <DataGridCheckBoxColumn Header="Running now" Binding="{Binding IsCurrent}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnRefreshBoot" Content="Refresh" Width="100"/>
            <Button x:Name="BtnRenameEntry" Content="Rename..." Width="100"/>
            <Button x:Name="BtnDefaultEntry" Content="Make default" Width="120"/>
            <Button x:Name="BtnDeleteEntry" Content="Delete" Width="100" Foreground="#B00020"/>
            <TextBlock Text="Menu timeout (s):" VerticalAlignment="Center" Margin="20,0,6,0"/>
            <TextBox x:Name="TxtTimeout" Text="15" Width="60"/>
            <Button x:Name="BtnSetTimeout" Content="Apply" Width="80" Margin="6,0,0,0"/>
          </StackPanel>

          <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                     Text="Deleting an entry only removes it from the boot menu. The files on that partition stay where they are - remove them with Disk Management afterwards if you want the space back."/>

          <TextBlock Style="{StaticResource Header}" Text="After the install"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnReboot" Content="Reboot now" Width="130"/>
            <Button x:Name="BtnOpenLogFolder" Content="Open log folder" Width="140"/>
            <Button x:Name="BtnOpenDiskMgmt" Content="Disk Management" Width="150"/>
          </StackPanel>
        </StackPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
